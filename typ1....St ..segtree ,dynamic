struct segtree{
    vector<item> val;

    int sz =1;
    segtree(int n){
        while(sz<n)sz*=2;
        val.resize(2*sz);
    }

    item  NEUTRAl_ElEMENT   ;
    item merge(item& m1 ,item& m2 , int x=-1){


          item res;
          res . a = m1.a +m2.a;
          int cnt  =  0 ;
          for (int i = 40; i>=0; --i){
            res.a+= cnt * m2.mp[i];
            cnt+=m1.mp[i];
            res.mp[i] =m1.mp[i] +m2.mp[i];
          }
          return res;
    }
    item single(int v){
       item res;
       res.mp[v]++;
       res.a = 0 ;
       return res;
    }
    void Set(int i  ,int v,int x , int lx  ,int rx){
        if (rx-lx==1){
            val[x] =  single(v) ;
            return  ;
        }
        int md  = (lx+rx)/2;
        if (i<md)
            Set(i  ,v ,  2*x+1 ,lx, md);
        else
            Set(i , v, 2*x+2 , md  , rx);

        val[x] =merge(val[2*x+1] ,val[2*x+2], x) ;
    }
    void Set(int i  ,int v){
        Set(i , v,  0 , 0 ,sz);
    }
    item calc(int  l , int r , int x , int lx , int rx ){
          if (lx>=r ||rx<=l)
            return NEUTRAl_ElEMENT;
