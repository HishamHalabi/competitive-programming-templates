            return val[x];
          }
          int md  = (lx+rx)/2;
          item c1 =calc(l ,r  ,2*x+1  , lx  , md)  ,
          c2 =calc(l ,r  ,2*x+2  ,md  , rx) ;
        return merge(c1 ,
             c2);


    }
    int calc(int l , int r   ){
        return calc(l,r  , 0 , 0,sz).a;
    }


};
